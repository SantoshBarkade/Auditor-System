# ==============================================================================
# NEXORA Environment Configuration Template (.env.example)
# ==============================================================================
# INSTRUCTIONS: Copy this file to .env and provide your deployment-specific values.
# NEVER commit .env or any file containing actual production secrets to git.

PROJECT_NAME="NEXORA Multi-Vendor Network Security Compliance Auditor"
VERSION="1.0.0-production"
ENV="production"

# ------------------------------------------------------------------------------
# Backend Database Configuration (PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Async driver for FastAPI (asyncpg)
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>

# Sync driver for Alembic migrations and synchronous scripts
SYNC_DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<dbname>

# Optional Supabase credentials
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# Advisory AI & RAG Provider Configuration (NVIDIA NIM)
# Note: AI is strictly ADVISORY. Deterministic engine computes all compliance verdicts.
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=your_nvidia_nim_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL="meta/llama-3.2-11b-vision-instruct"

# ------------------------------------------------------------------------------
# Backend Security & Access Control
# ------------------------------------------------------------------------------
# Static admin token for protected administrative and settings endpoints
ADMIN_TOKEN=your_secure_admin_token_here

# Comma-separated allowed CORS origins (Vercel production domain & local dev)
CORS_ORIGINS=https://nexora.vercel.app,http://localhost:5173,http://localhost:3000

# Optional Regex for Vercel preview deployment origins (e.g. *.vercel.app)
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Maximum file upload size in bytes (default 5MB)
MAX_UPLOAD_SIZE=5242880

# ------------------------------------------------------------------------------
# Frontend Environment Configuration (frontend/.env)
# ------------------------------------------------------------------------------
# Public API root for frontend SPA. Do NOT put database or AI secrets here.
VITE_API_URL=https://your-deployed-backend-domain.com
